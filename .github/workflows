name: Deploy to GitHub Pages

on:
  push:
    branches: ["main"]
  # Memungkinkan deploy manual dari tab Actions di GitHub
  workflow_dispatch:

# Berikan izin akses token untuk menulis deployment Pages
permissions:
  contents: read
  pages: write
  id-token: write

# Cegah konflik konkurensi antar deployment yang bersamaan
concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload Artifact
        uses: actions/upload-pages-artifact@v3
        with:
          # Unggah seluruh folder root (index.html, css, js, model_web)
          path: '.'

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
